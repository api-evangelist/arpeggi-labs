        "type": "text/plain"
      },
      "item": [
        {
          "id": "50d565dc-e98f-43d2-ac33-c73fbb4ea196",
          "name": "Create a new voice conversion job",
          "request": {
            "name": "Create a new voice conversion job",
            "description": {
              "content": "Creates a voice conversion inference job and adds it to the inference queue. All requests must be made as multipart form requests. The response contains the job status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "voice-conversions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "voiceModelId",
                  "value": "<integer>",
                  "type": "text",
                  "description": "(Required) ID of the voice model."
                },
                {
                  "key": "soundFile",
                  "type": "file",
                  "description": "(Required) Input audio. Supports wav, mp3, or flac. Max 100MB."
                },
                {
                  "key": "conversionStrength",
                  "value": "<number>",
                  "type": "text",
                  "description": "Amount of accent from the voice model (0 to 1)."
                },
                {
                  "key": "modelVolumeMix",
                  "value": "<number>",
                  "type": "text",
                  "description": "Mix between input volume and model volume (0 to 1)."
                },
                {
                  "key": "pitchShift",
                  "value": "<number>",
                  "type": "text",
                  "description": "Semitones to shift the input audio (-24 to 24)."
                },
                {
                  "key": "pre",
                  "value": "{\"NoiseGate\":{\"threshold_db\":\"<number>\",\"ratio\":\"<number>\",\"attack_ms\":\"<number>\",\"release_ms\":\"<number>\"},\"HighPassFilter\":{\"cutoff_frequency_hz\":\"<number>\"},\"LowPassFilter\":{\"cutoff_frequency_hz\":\"<number>\"},\"Compressor\":{\"threshold_db\":\"<number>\",\"ratio\":\"<number>\",\"attack_ms\":\"<number>\",\"release_ms\":\"<number>\"}}",
